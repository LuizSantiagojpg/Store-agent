# ============================================================================
# Empório da Música AI Agent — Environment Configuration
# ============================================================================
# Choose your preferred LLM provider: "gemini" (default), "openai", or "local"
LLM_PROVIDER=gemini

# Google Gemini API (Recommended — Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / OpenAI-Compatible API (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
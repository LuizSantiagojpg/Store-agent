# ============================================================================
# Empório da Música AI Agent — Environment Configuration
# ============================================================================
# Choose your preferred LLM provider: "lmstudio" (default local), "gemini", "openai", or "deepseek"
LLM_PROVIDER=lmstudio

# Local LLM via LM Studio (OpenAI-Compatible Server — Default)
LMSTUDIO_BASE_URL=http://172.24.112.1:1234/v1
LMSTUDIO_MODEL=meta-llama-3.1-8b-instruct
LMSTUDIO_API_KEY=lm-studio

# Google Gemini API (Optional Cloud Alternative — https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI / OpenAI-Compatible API (Optional Cloud Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
